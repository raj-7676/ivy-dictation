+void clip_ivy_set_abort_callback(clip_ctx * ctx, ggml_abort_callback cb, void * data) {
+    if (!ctx || !ctx->backend_cpu) {
+        return;
+    }
+    ggml_backend_dev_t dev = ggml_backend_get_device(ctx->backend_cpu);
+    ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    auto * set = reg ? (void (*)(ggml_backend_t, ggml_abort_callback, void *))
+                           ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_abort_callback") : nullptr;
+    if (set) {
+        set(ctx->backend_cpu, cb, data);
+    }
+}
+
+void clip_ivy_set_threadpool(clip_ctx * ctx, ggml_threadpool_t tp) {
+    if (!ctx || !ctx->backend_cpu) {
+        return;
+    }
+    ggml_backend_dev_t dev = ggml_backend_get_device(ctx->backend_cpu);
+    ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    auto * set = reg ? (void (*)(ggml_backend_t, ggml_threadpool_t))
+                           ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_set_threadpool") : nullptr;
+    if (set) {
+        set(ctx->backend_cpu, tp);
+    }
+}
